{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "http://api.vercel.internal"
    }
  ],
  "services": {
    "api": {
      "root": "fastapi_doc",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  }
}
